/* 全局样式 */
page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #2b2f36;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #2f6fed;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
}

.muted {
  color: #8a8f99;
  font-size: 24rpx;
}
