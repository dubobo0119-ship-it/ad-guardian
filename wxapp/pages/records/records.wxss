/* 举报记录页样式 */
.empty {
  font-weight: 600;
  margin-bottom: 12rpx;
}

.rec-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.badge-wait {
  background: #f0f4ff;
  color: #2f6fed;
}

.badge-due {
  background: #fff1f0;
  color: #cf1322;
}

.due-tip {
  margin-top: 12rpx;
  padding: 14rpx;
  background: #fff1f0;
  border-radius: 8rpx;
  font-size: 25rpx;
  color: #cf1322;
}

.del {
  margin-top: 16rpx;
  text-align: right;
  font-size: 24rpx;
  color: #8a8f99;
}
