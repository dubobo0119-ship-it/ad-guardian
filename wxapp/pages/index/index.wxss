/* 一键举报页样式 */
.desc-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.shot-btn {
  margin-top: 20rpx;
  background: #f0f4ff;
  color: #2f6fed;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.shot-preview {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 12rpx;
}

.ai-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.warn {
  color: #d46b08;
  font-size: 26rpx;
}

.strong {
  font-weight: 600;
}

.ai-summary {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f0f7ff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.field-label {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #555;
}

.picker-box, .text-input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-top: 10rpx;
}

.report-box {
  background: #f9fafc;
  border: 1rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.channel {
  background: #f9fafc;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

/* 分步提交指引 */
.channel-steps-title {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2f6fed;
}

.channel-step {
  font-size: 25rpx;
  color: #444;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* 渠道直达按钮 */
.go-btn {
  margin-top: 16rpx;
  background: #e8f5ee;
  color: #07a356;
  font-size: 27rpx;
  border-radius: 10rpx;
}

/* 我提交了按钮 */
.btn-mark {
  background: #fff7e6;
  color: #d46b08;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
}

.footer-tip {
  text-align: center;
  padding: 30rpx 40rpx 60rpx;
}
