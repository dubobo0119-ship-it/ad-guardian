<!-- 违规知识库页 -->
<view class="card">
  <view class="sec-title">8 类被明令禁止的违规广告</view>
  <view class="muted">依据《广告法》《互联网广告管理办法》《互联网弹窗信息推送服务管理规定》及工信部专项整治要求整理。</view>
</view>

<view class="card" wx:for="{{violations}}" wx:key="key">
  <view class="v-name">{{item.name}}</view>
  <view class="v-symptom">现象:{{item.symptom}}</view>
  <view class="v-basis" wx:for="{{item.basis}}" wx:for-item="b" wx:key="*this">· {{b}}</view>
</view>

<view class="card">
  <view class="sec-title">4 个官方举报渠道</view>
</view>

<view class="card" wx:for="{{channels}}" wx:key="key">
  <view class="v-name">{{item.name}}</view>
  <view>管什么:{{item.scope}}</view>
  <view>在哪举报:{{item.entry}}</view>
</view>
